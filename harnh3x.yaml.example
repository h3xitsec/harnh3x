# Copy to ~/.config/harnh3x/harnh3x.yaml
# A non-empty environment variable overrides the matching scalar.
# Environment variables do not override mcp.

api_key: sk-...
api_url: http://127.0.0.1:11434/v1
model: model_name

# provider: openai
# max_tokens: 8192
# context_limit: 200000
# max_turns: 45
# compact_at: 0.5
# max_tool_result: 8000
# fetch_timeout: 15
# fetch_max_bytes: 2000000
# fetch_max_redirects: 5
# search_max_results: 8
# feed_max_items: 20
# shell_timeout: 30
# shell_max_timeout: 120
# list_files_max: 200
# search_files_max: 100
# pdf_max_pages: 20
# preview_rows: 10
# wikipedia_lang: en
# base_dir: ~/.harnh3x

# mcp:
#   caido:
#     command: caido-mcp-server
#     args: [serve]
#     env:
#       CAIDO_URL: http://127.0.0.1:8080
#       CAIDO_ACCESS_TOKEN: "..."
#     # Leave CAIDO_ALLOW_SENSITIVE_HEADERS unset unless an engagement
#     # needs real Authorization, Cookie, and API key values in tool output.
#     # timeout: 60
#     include: [caido_list_requests]
#     # Without description, the menu line comes from the server.
#     # description: Browse and replay HTTP traffic in the local Caido proxy.
#     # instructions: |
#     #   Search history with HTTPQL, then fetch one request by id.
#     #   Replay with caido_send_request or caido_edit_request so the request
#     #   shows up in the project.
#     #   Check scope before testing a host. Record confirmed issues as findings.
#     #   Do not invent cookie or token values the tool did not return.
#     #   To call a public JSON API with no proxy, use the http skill.
