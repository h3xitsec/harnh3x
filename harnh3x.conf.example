# Copy to ~/.config/harnh3x/harnh3x.conf
# A non-empty environment variable overrides the matching line.
# Blank lines and full-line # comments are ignored. Values may be quoted.

api_key = sk-...
api_url = http://127.0.0.1:11434/v1
model = qwen3.5-128k

